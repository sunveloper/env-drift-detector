# Copy to .env and fill in real values. Never commit .env.

# Discord webhook that receives drift reports.
# Create via Discord: Server Settings > Integrations > Webhooks > New Webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-with-your-webhook-token

# Path to the env template that the scanner compares code against.
ENV_EXAMPLE_PATH=.env.example

# Comma-separated variable names to ignore (already provided by the platform).
ENV_DRIFT_IGNORE=PATH,HOME,PYTHONPATH,NODE_ENV,CI,PORT

# Exit with code 1 when a required variable is undocumented.
# Set to false to report without failing CI.
ENV_DRIFT_FAIL_ON_MISSING=true

# Start of the range to diff. Defaults to HEAD^ (the single latest commit).
# In CI this is normally set from the push event rather than committed here.
ENV_DRIFT_BASE_REF=
